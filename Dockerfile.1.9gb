# Use the official Node.js runtime as the base image
FROM node:18-alpine AS base

# Install Bun and other dependencies
RUN apk add --no-cache libc6-compat curl unzip bash
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"
RUN bun --version

# Install dependencies
FROM base AS deps
WORKDIR /app
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

# Build the application with ultra-low memory settings for 1.9GB server
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Set ultra-conservative memory optimization for 1.9GB server
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=768 --max-semi-space-size=32 --optimize-for-size"
ENV BUN_OPTIONS="--max-old-space-size=768"

# Additional memory optimization for low-memory systems
ENV NODE_GC_INTERVAL=50
ENV NODE_GC_OLD_SPACE_SIZE=768
ENV NODE_GC_NEW_SPACE_SIZE=64
ENV NODE_GC_FORCE_INTERVAL=100

# Set build-specific optimizations for ultra-low memory
ENV NEXT_BUILD_WORKERS=1
ENV NEXT_BUILD_MEMORY_LIMIT=768

# Use ultra-low memory build script
COPY build-ultra-low-memory.sh ./
RUN chmod +x build-ultra-low-memory.sh
RUN ./build-ultra-low-memory.sh

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create system user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy assets and built app
COPY --from=builder /app/public ./public
RUN mkdir .next && chown nextjs:nodejs .next
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["node", "server.js"]
